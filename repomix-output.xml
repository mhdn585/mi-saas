  { to: 'products', label: 'Productos', Icon: IconPackage, end: false },
  { to: 'inventory', label: 'Inventario', Icon: IconBoxes, end: false },
  { to: 'statistics', label: 'Estadísticas', Icon: IconChart, end: false },
